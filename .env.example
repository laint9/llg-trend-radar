# Sao chép thành .env để chạy local (KHÔNG commit file .env)
# Trên GitHub: Settings → Secrets and variables → Actions → New repository secret

# Crawl TikTok / Instagram / Facebook / Threads (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# YouTube Data API v3, miễn phí (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=

# AI insight: điền 1 trong 3 key, hoặc để trống để chạy không dùng AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Tuỳ chọn (đặt ở tab "Variables" trên GitHub): auto | anthropic | openai | gemini | none
AI_PROVIDER=auto
# AI_MODEL=claude-opus-5-5
