  "apify": {
    "_note": "Cần biến môi trường APIFY_TOKEN. Mỗi nền tảng có thể bật/tắt. 'input' hỗ trợ placeholder {{hashtags}}, {{queries}}, {{urls}}, {{limit}}. Actor bên thứ ba có thể đổi tên field, nên kiểm tra input schema trên Apify Console.",
    "maxItemsPerPlatform": 60,
    "timeoutSecs": 600,
    "_budgetNote": "Gói Apify FREE có 5 USD/tháng. monthlyBudgetUsd: tự dừng crawl khi đã dùng ≥ 95% ngân sách. everyDays: chạy mỗi N ngày (ngày không chạy sẽ dùng lại dữ liệu gần nhất). maxChargeUsd: trần chi phí mỗi lượt chạy. Nâng lên gói Starter (39 USD) thì có thể để everyDays = 1.",
    "monthlyBudgetUsd": 5,
    "platforms": {
      "tiktok": {
        "enabled": true,
        "actor": "clockworks~tiktok-scraper",
        "everyDays": 3,
        "maxChargeUsd": 0.2,
        "hashtags": ["saigonnightlife", "cocktailbar", "hiddenbar", "speakeasy", "quan1", "thaodien", "rooftopbar", "reviewnhahang"],
        "input": { "hashtags": "{{hashtags}}", "resultsPerPage": 6, "shouldDownloadVideos": false, "shouldDownloadCovers": false, "shouldDownloadSlideshowImages": false, "shouldDownloadAvatars": false }
      },
      "instagram": {
        "enabled": true,
        "actor": "apify~instagram-hashtag-scraper",
        "everyDays": 3,
        "maxChargeUsd": 0.12,
        "hashtags": ["saigonbar", "saigoncocktail", "saigonnightlife", "speakeasysaigon", "saigonfoodie", "bangkokbar"],
        "input": { "hashtags": "{{hashtags}}", "resultsLimit": 6, "resultsType": "posts" }
      },
      "facebook": {
        "enabled": true,
        "actor": "apify~facebook-posts-scraper",
        "_note": "Facebook không cho tìm theo hashtag ổn định. Liệt kê các Page/Group công khai cần theo dõi (báo, review food, đối thủ).",
        "urls": [
          "https://www.facebook.com/saigoneer",
          "https://www.facebook.com/timeoutvietnam"
        ],
        "everyDays": 7,
        "maxChargeUsd": 0.12,
        "input": { "startUrls": "{{urls}}", "resultsLimit": 10 }
      },
      "threads": {
        "enabled": true,
        "actor": "themineworks~threads-scraper",
        "runEach": "queries",
        "everyDays": 7,
        "maxChargeUsd": 0.5,
        "_runEachNote": "Actor này nhận 1 từ khoá/lượt nên chạy lần lượt từng query ({{query}}). Chi phí ~0,002 USD/bài.",
        "queries": ["quán bar sài gòn", "cocktail sài gòn", "hidden bar sài gòn", "quán bar quận 1", "nhà hàng thảo điền", "đi bar"],
        "input": { "mode": "search", "searchQuery": "{{query}}", "maxPosts": "{{limit}}", "resultType": "recent", "includeReplies": false }
      },
      "googlemaps": {
        "enabled": true,
        "kind": "venue",
        "actor": "compass~crawler-google-places",
        "_note": "Theo dõi địa điểm trên Google Maps: số review tăng nhanh = đang hot. Thêm tên đối thủ vào queries để theo dõi trực tiếp.",
        "everyDays": 7,
        "maxChargeUsd": 0.3,
        "queries": ["cocktail bar quận 1", "speakeasy quận 1", "rooftop bar quận 1", "fine dining quận 1", "cocktail bar thảo điền", "nhà hàng thảo điền"],
        "input": { "searchStringsArray": "{{queries}}", "locationQuery": "Ho Chi Minh City, Vietnam", "maxCrawledPlacesPerSearch": 10, "language": "vi", "maxReviews": 0, "skipClosedPlaces": true, "scrapePlaceDetailPage": false }
      },
      "tripadvisor": {
        "enabled": true,
        "kind": "venue",
        "actor": "maxcopell~tripadvisor",
        "_note": "Tripadvisor chặn crawl trực tiếp nên phải đi qua Apify. Khách quốc tế/expat dùng nhiều, rất quan trọng với Q1/Q2.",
        "urls": [
          "https://www.tripadvisor.com/Restaurants-g293925-Ho_Chi_Minh_City.html",
          "https://www.tripadvisor.com/Attractions-g293925-Activities-c20-Ho_Chi_Minh_City.html"
        ],
        "everyDays": 14,
        "maxChargeUsd": 0.25,
        "input": { "startUrls": "{{urls}}", "maxItemsPerQuery": 25, "language": "en", "currency": "VND", "includeTags": true, "maxPhotosPerPlace": 0 }
      }
    }
  },

